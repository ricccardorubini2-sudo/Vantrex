# Public site URL for canonical links, Open Graph, robots, and the sitemap.
# Leave blank until the production domain is confirmed. Do not invent one.
# Example, once confirmed: https://example.com
SITE_URL=

# SMTP delivery for the contact form. Leave every value blank until the
# mailbox and mail server are confirmed. The site runs without them.
# The form then says delivery is unavailable and does not claim a message was sent.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=

# Automated tests set CONTACT_DELIVERY=mock with NODE_ENV=test.
# That mode is ignored outside tests and is not live inbox delivery.
# CONTACT_DELIVERY=
